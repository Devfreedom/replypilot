# Local development only. Copy this file to .env and replace the password.
# Never commit .env or use these values in production.
POSTGRES_DB=replypilot
POSTGRES_USER=replypilot
POSTGRES_PASSWORD=change-me-local-development-password
POSTGRES_PORT=5433

DATABASE_URL=postgresql://replypilot:change-me-local-development-password@127.0.0.1:5433/replypilot
TEST_DATABASE_URL=postgresql://replypilot:change-me-local-development-password@127.0.0.1:5433/replypilot_test

# The API defaults to port 4000. Set PORT inline when starting the API rather
# than in this file, because Next.js also loads .env and respects PORT.
# The Next.js development server proxies browser requests to this local API.
API_ORIGIN=http://127.0.0.1:4000
