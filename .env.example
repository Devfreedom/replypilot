# Local development only. Copy this file to .env and replace the password.
# Never commit .env or use these values in production.
POSTGRES_DB=replypilot
POSTGRES_USER=replypilot
POSTGRES_PASSWORD=change-me-local-development-password
POSTGRES_PORT=5433

DATABASE_URL=postgresql://replypilot:change-me-local-development-password@127.0.0.1:5433/replypilot
TEST_DATABASE_URL=postgresql://replypilot:change-me-local-development-password@127.0.0.1:5433/replypilot_test

# The API defaults to port 4000. Set PORT inline when starting the API rather
# than in this file, because Next.js also loads .env and respects PORT.
# The Next.js development server proxies browser requests to this local API.
API_ORIGIN=http://127.0.0.1:4000

# Better Auth configuration. Generate a fresh secret; do not commit the real
# value. Example: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_ME
# Public application origin used by Better Auth for session cookies and origin
# checks. In production this must be the HTTPS frontend origin.
BETTER_AUTH_URL=http://localhost:3000
# Extra trusted browser origins, comma-separated. Local development also trusts
# http://localhost:3000 and http://127.0.0.1:3000 automatically. Production
# must list only the real HTTPS frontend origin(s).
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Single-business legacy inbound and delivery-status WhatsApp test
# integration. Leave every WHATSAPP_* value empty to disable webhook handling.
# The webhook verification token and app secret are required whenever any
# WHATSAPP_* value is set. The legacy phone-number/workspace pair is optional;
# when present, it keeps the original single-workspace routing during the
# multi-workspace connection migration. These are server-only values: never
# expose the app secret or verification token to the browser.
#
# - WHATSAPP_WEBHOOK_VERIFY_TOKEN: your own Meta webhook verification string.
# - WHATSAPP_APP_SECRET: Meta App Dashboard -> App settings -> Basic -> App secret.
# - WHATSAPP_TEST_PHONE_NUMBER_ID: optional legacy test business phone number ID
#   from WhatsApp -> API Setup. It is numeric and is not the displayed number.
# - WHATSAPP_TEST_WORKSPACE_ID: optional UUID of the legacy workspace that
#   should receive those conversations. Set it together with the phone-number ID.

# Multi-workspace WhatsApp connection credential encryption (Milestone 14A).
# Tokens are encrypted with AES-256-GCM before storage. Generate a 32-byte key
# with: openssl rand -base64 32
# Keep this key in a secret manager. Never commit it, log it, or expose it to
# the browser. Changing the key requires re-encrypting stored credentials.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
WHATSAPP_CREDENTIAL_KEY_VERSION=v1

# Meta WhatsApp Cloud API outbound test messaging (Milestone 13).
# This is restricted to the configured test workspace, sender, and recipient
# allowlist. It is disabled by default and is rejected in NODE_ENV=production,
# even if META_OUTBOUND_ENABLED=true. Use only a Meta test sender and explicitly
# opted-in test recipients; never enable this for production deployments.
#
# IMPORTANT: Never commit real values. Never put META_ACCESS_TOKEN in a URL
# query parameter, log, or API response. Store it in a secret manager and
# rotate it before expiry or immediately if exposed.
#
# - META_OUTBOUND_ENABLED: set to "true" to enable real Meta sending. Any
#   other value (including missing) keeps sending disabled (fail closed).
# - META_ACCESS_TOKEN: your Meta app's access token. Rotate before it expires.
# - META_GRAPH_API_VERSION: the Graph API version to use (e.g. "v21.0").
#   Must match the version configured in the Meta App Dashboard.
# - WHATSAPP_SENDER_PHONE_NUMBER_ID: the numeric phone-number ID of the
#   business sender. From WhatsApp -> API Setup in the Meta App Dashboard.
#   This is not the phone number itself.
# - META_OUTBOUND_TEST_WORKSPACE_ID: the UUID of the one ReplyPilot workspace
#   permitted to send real WhatsApp messages during testing.
# - META_TEST_RECIPIENT_PHONE_NUMBERS: comma-separated E.164 phone numbers
#   that are allowed to receive test messages. All other numbers are rejected
#   before any HTTP request is made to Meta. Must be non-empty when enabled.
META_OUTBOUND_ENABLED=false
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
WHATSAPP_SENDER_PHONE_NUMBER_ID=
META_OUTBOUND_TEST_WORKSPACE_ID=
META_TEST_RECIPIENT_PHONE_NUMBERS=

# Local-only controlled-failure controls for the mock outbound provider. Leave
# empty for normal development. Rejected when NODE_ENV=production. Each value is
# a comma-separated list of outbound idempotency keys (for an approved draft the
# key is "reply-draft:<draft UUID>").
#
# OUTBOUND_MOCK_FAIL_KEYS makes matching records fail every attempt and end in
# "failed". OUTBOUND_MOCK_AMBIGUOUS_KEYS makes matching records end in
# "manual_review" without an unsafe automatic retry.
OUTBOUND_MOCK_FAIL_KEYS=
OUTBOUND_MOCK_AMBIGUOUS_KEYS=
